# Copy to .env and fill in as needed. Nothing here is required to boot the
# platform except DATABASE_URL/REDIS_URL — every connector API key degrades
# gracefully to "skip, log a coverage gap" when absent (see each connector's
# `requiresApiKey` field).

NODE_ENV=development

# --- Core infra (see infra/docker-compose.yml) ---
DATABASE_URL=postgres://osint:osint_dev_password@localhost:55432/osint
REDIS_URL=redis://localhost:56379
MINIO_ENDPOINT=http://localhost:59000
MINIO_ACCESS_KEY=osint_minio
MINIO_SECRET_KEY=osint_dev_password
MINIO_BUCKET=osint-evidence

# --- Auth ---
# Seed script (`pnpm db:seed`) creates this admin. Change the password after first login.
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=change-me-immediately

# --- Connector API keys, connectors that actually exist (optional — omit to skip that connector) ---
COURTLISTENER_API_TOKEN=      # federal.courtlistener — works keyless too, just at a lower rate limit. accepts: person_name only
TWILIO_ACCOUNT_SID=           # consumer_api.twilio_lookup — requires both SID+token. accepts: phone_e164 only
TWILIO_AUTH_TOKEN=
SHODAN_API_KEY=               # digital.shodan — requires a key, no keyless tier. accepts: ip_address only
OPENCORPORATES_API_KEY=       # business.opencorporates — works keyless too, heavily rate-limited without one. accepts: person_name only
LICENSED_PLATE_VENDOR_API_KEY=  # licensed_vendor.plate_lookup — disabled by default; no vendor is actually wired even if this is set. DPPA 2721 permissible-use registered-owner lookups require your own vendor certification, which this codebase deliberately does not provide. accepts: license_plate only

# --- NOT YET IMPLEMENTED — no connector reads these env vars at all right now.
# Listed here only as placeholders matching docs/PLAN.md's full aspirational
# catalog; setting one currently does nothing. See README's "What's not
# built yet" for the honest current connector list (21 built, all above +
# everything free/keyless — OFAC, FBI Wanted, SEC EDGAR, NHTSA VIN, etc.).
ENFORMION_API_KEY=
PEOPLEDATALABS_API_KEY=
NUMVERIFY_API_KEY=
HUNTER_API_KEY=
IPQUALITYSCORE_API_KEY=
HIBP_API_KEY=

# --- Collection posture (packages/browser) ---
# JSON array of {server, username?, password?, region?} — see packages/browser/src/proxy/pool.ts
PROXY_POOL_JSON=
# skip | manual | <third-party-provider-id> — see packages/browser/src/captcha/solver.ts
CAPTCHA_SOLVER_PROVIDER=skip
CAPTCHA_SOLVER_API_KEY=

# --- Vision sidecar (apps/vision) — real FastAPI + InsightFace service, run separately (see README) ---
VISION_SERVICE_URL=http://localhost:58001
# Where the vision service caches its ~280MB InsightFace model pack (Docker: /models via the vision-models volume)
MODEL_CACHE_DIR=
