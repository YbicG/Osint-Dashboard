{
  "name": "osint-dashboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:live": "turbo run test:live",
    "db:generate": "pnpm --filter @osint/db db:generate",
    "db:migrate": "pnpm --filter @osint/db db:migrate",
    "db:seed": "pnpm --filter @osint/db db:seed",
    "db:studio": "pnpm --filter @osint/db db:studio",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.14.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.8.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
